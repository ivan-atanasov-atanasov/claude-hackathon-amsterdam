# Copy this file to .env and fill in the values below.

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# MCP server credentials
SLACK_BOT_TOKEN=xoxb-...          # Slack app OAuth token
SLACK_TEAM_ID=T...                # Slack workspace ID
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_...
SUPABASE_ACCESS_TOKEN=sbp_...     # supabase.com → Account → Access Tokens
TAVILY_API_KEY=tvly-...           # app.tavily.com → API Keys
HF_TOKEN=hf_...                  # huggingface.co → Settings → Access Tokens
